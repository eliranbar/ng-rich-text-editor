{
  "name": "ng-rich-text-editor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-richtext",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-richtext --watch --configuration development",
    "test": "ng test ngx-richtext --watch=false",
    "test:demo": "ng test demo --watch=false",
    "e2e": "playwright test",
    "license": "node tools/generate-license.mjs",
    "pack:lib": "ng build ngx-richtext && npm pack ./dist/ngx-richtext",
    "publish:dry": "ng build ngx-richtext && npm publish ./dist/ngx-richtext --dry-run"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1"
  }
}
